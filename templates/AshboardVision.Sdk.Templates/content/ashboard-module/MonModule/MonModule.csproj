<Project Sdk="Microsoft.NET.Sdk">

  <!-- Le module : une DLL (MonModule.dll) et son manifest.json, côte à côte dans le dossier de sortie (bin/Debug/net10.0). Le logiciel fournit
       lui-même le SDK et SkiaSharp au module : les copies qui se retrouvent dans le dossier de sortie ne servent à rien à l'exécution. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ModuleNamespace</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Le SDK, en version exacte : 1.1.0 est la version du paquet ; "sdk" dans manifest.json dit la plus ancienne version du SDK dont ton module a besoin (1.0 tant
         qu'il n'utilise rien de la 1.1, comme les raccourcis). Une version flottante (1.1.*) obligerait chaque restauration à interroger les
         sources de paquets (donc à échouer hors ligne) ; pour viser une version plus récente du SDK, change ce numéro, et le champ "sdk" du
         manifeste si tu utilises ce qu'elle apporte (voir le README). -->
    <PackageReference Include="AshboardVision.Sdk" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- ModuleKit part dans le paquet AshboardVision.Sdk (embarqué, voir ce projet) : sa documentation XML l'accompagne. -->
  <PropertyGroup>
    <!-- Comme le SDK (voir AshboardVision.Sdk.csproj) : AssemblyVersion reste 1.0.0.0 pour toute la ligne 1.x, quelle que soit la version du logiciel
         (FileVersion et InformationalVersion, elles, suivent <Version>). Sans cela, un module compilé plus tard contre ce paquet demanderait une
         version d'assemblage plus haute que celle d'un hôte plus ancien. -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Trofeo.Core.Tests" />
  </ItemGroup>

</Project>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:Trofeo.Settings"
             xmlns:vm="clr-namespace:Trofeo.Settings.ViewModels"
             xmlns:views="clr-namespace:Trofeo.Settings.Views"
             xmlns:controls="clr-namespace:Trofeo.Settings.Controls"
             x:Class="Trofeo.Settings.Views.SettingsTabView"
             x:DataType="vm:SettingsTabViewModel">

  <!-- Deux colonnes calmes et équilibrées, alignées à gauche : l'écran, l'aperçu, le démarrage et les mises à jour ; puis les capteurs, la consommation, le partage et l'assistant. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" AllowAutoHide="False">
    <StackPanel Spacing="16" Margin="0,0,8,0">
    <Grid ColumnDefinitions="*,16,*">

      <StackPanel Grid.Column="0" Spacing="16">

        <!-- Orientation et images par seconde. -->
        <Border Classes="panel" Padding="20">
          <StackPanel Spacing="20">
            <StackPanel Spacing="10">
              <TextBlock Classes="section" Text="{x:Static t:Texts.SettingsOrientation}" />
              <StackPanel Orientation="Horizontal" Spacing="8" AutomationProperties.Name="{x:Static t:Texts.SettingsOrientation}">
                <Button Name="UprightButton" Classes="choice" Classes.primary="{Binding IsUpright}"
                        Content="{x:Static t:Texts.SettingsUpright}" Command="{Binding SetUprightCommand}" />
                <Button Name="FlippedButton" Classes="choice" Classes.primary="{Binding IsFlipped}"
                        Content="{x:Static t:Texts.SettingsFlipped}" Command="{Binding SetFlippedCommand}" />
              </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Classes="section" Text="{x:Static t:Texts.SettingsFps}" />
              <Grid ColumnDefinitions="*,Auto">
                <Slider Grid.Column="0" Name="FpsSlider" Minimum="1" Maximum="12" SmallChange="1" LargeChange="2"
                        TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Static t:Texts.SettingsFps}"
                        Value="{Binding MaxFpsValue}" />
                <TextBlock Grid.Column="1" Name="FpsText" Classes="number lead" MinWidth="200" VerticalAlignment="Center"
                           Margin="16,0,0,0" Text="{Binding MaxFpsText}" />
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Démarrage avec Windows et aperçu. -->
        <Border Classes="panel" Padding="20">
          <StackPanel Spacing="20">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="name" Text="{x:Static t:Texts.SettingsStartup}" VerticalAlignment="Center" Margin="0,0,24,0" />
                <ToggleSwitch Grid.Column="1" Name="StartupSwitch" OnContent="" OffContent="" VerticalAlignment="Center"
                              AutomationProperties.Name="{x:Static t:Texts.SettingsStartup}"
                              IsEnabled="{Binding CanToggleStartup}" IsChecked="{Binding StartupEnabled}" />
              </Grid>
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static t:Texts.SettingsStartupHelp}" />
              <TextBlock Name="StartupMessage" Classes="warning" TextWrapping="Wrap" Text="{Binding StartupMessage}" IsVisible="{Binding HasStartupMessage}" />
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Classes="section" Text="{x:Static t:Texts.SettingsPreview}" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="name" Text="{x:Static t:Texts.SettingsRealTime}" VerticalAlignment="Center" Margin="0,0,24,0" />
                <ToggleSwitch Grid.Column="1" Name="RealTimeSwitch" OnContent="" OffContent="" VerticalAlignment="Center"
                              AutomationProperties.Name="{x:Static t:Texts.SettingsRealTime}"
                              IsChecked="{Binding RealTimePreview}" />
              </Grid>
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static t:Texts.SettingsRealTimeHelp}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock Name="VersionText" Classes="muted" Margin="4,0,0,0" Text="{Binding VersionText}" />

        <!-- Les mises à jour : Stable ou Bêta, la recherche, l'installation ; la boîte du retour en arrière s'ouvre ici. -->
        <Border Name="UpdatesPanel" Classes="panel" Padding="20">
          <StackPanel Spacing="12">
            <TextBlock Classes="section" Text="{x:Static t:Texts.SettingsUpdates}" />
            <StackPanel Spacing="8">
              <TextBlock Classes="name" Text="{x:Static t:Texts.UpdatesChannel}" />
              <StackPanel Orientation="Horizontal" Spacing="8" AutomationProperties.Name="{x:Static t:Texts.UpdatesChannel}">
                <Button Name="StableButton" Classes="choice" Classes.primary="{Binding IsStableChannel}"
                        Content="{x:Static t:Texts.UpdatesStable}" Command="{Binding SetStableCommand}"
                        IsEnabled="{Binding UpdateControlsEnabled}" />
                <Button Name="BetaButton" Classes="choice" Classes.primary="{Binding IsBetaChannel}"
                        Content="{x:Static t:Texts.UpdatesBeta}" Command="{Binding SetBetaCommand}"
                        IsEnabled="{Binding UpdateControlsEnabled}" />
              </StackPanel>
            </StackPanel>
            <TextBlock Name="UpdateStatus" Classes="muted" TextWrapping="Wrap" Text="{Binding UpdateStatusText}" IsVisible="{Binding HasUpdateStatus}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Name="CheckUpdatesButton" Content="{x:Static t:Texts.UpdatesCheck}" Command="{Binding CheckUpdatesCommand}"
                      IsEnabled="{Binding CanCheckUpdates}" />
              <Button Name="InstallUpdateButton" Classes="primary" Content="{Binding InstallUpdateText}" Command="{Binding InstallUpdateCommand}"
                      IsVisible="{Binding ShowInstallUpdate}" IsEnabled="{Binding UpdateControlsEnabled}" />
            </StackPanel>
            <ContentControl Name="DowngradeBox" Content="{Binding Downgrade}" HorizontalContentAlignment="Stretch">
              <ContentControl.DataTemplates>
                <DataTemplate DataType="vm:DowngradeDialogViewModel"><views:DowngradeDialogView /></DataTemplate>
              </ContentControl.DataTemplates>
            </ContentControl>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel Grid.Column="2" Spacing="16">

        <!-- Les températures du processeur : l'état en une phrase, l'installation. -->
        <Border Classes="panel" Padding="20">
          <StackPanel Spacing="10">
            <TextBlock Classes="section" Text="{x:Static t:Texts.SettingsSensors}" />
            <views:SensorsBlock />
          </StackPanel>
        </Border>

        <!-- La consommation : le service, cette fenêtre, l'objectif. -->
        <Border Classes="panel" Padding="20">
          <StackPanel Spacing="8">
            <TextBlock Classes="section" Text="{x:Static t:Texts.SettingsUsage}" />
            <TextBlock Name="ServiceUsage" Classes="lead" TextWrapping="Wrap" Text="{Binding ServiceUsageText}" />
            <TextBlock Name="OwnUsage" Classes="lead" TextWrapping="Wrap" Text="{Binding OwnUsageText}" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static t:Texts.UsageGoal}" />
          </StackPanel>
        </Border>

        <!-- Partager une disposition. -->
        <Border Classes="panel" Padding="20">
          <StackPanel Spacing="10">
            <TextBlock Classes="section" Text="{x:Static t:Texts.SettingsShare}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Name="ExportButton" Content="{x:Static t:Texts.ShareExport}" Command="{Binding ExportCommand}" />
              <Button Name="ImportButton" Content="{x:Static t:Texts.ShareImport}" Command="{Binding ImportCommand}" />
            </StackPanel>
            <TextBlock Name="ShareMessage" TextWrapping="Wrap" Text="{Binding ShareMessage}" IsVisible="{Binding HasShareMessage}"
                       Classes.error="{Binding ShareMessageIsError}" Classes.muted="{Binding !ShareMessageIsError}" />
          </StackPanel>
        </Border>

        <!-- Relancer l'assistant de première ouverture. -->
        <Border Classes="panel" Padding="20">
          <StackPanel Spacing="10">
            <TextBlock Classes="section" Text="{x:Static t:Texts.SettingsFirstRun}" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static t:Texts.SettingsFirstRunHelp}" />
            <Button Name="RestartFirstRunButton" HorizontalAlignment="Left"
                    Content="{x:Static t:Texts.SettingsFirstRunRestart}" Command="{Binding RestartFirstRunCommand}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <!-- Les modules complémentaires (créés par la communauté) : une ligne par module, l'installation, les mises à jour. -->
    <Border Name="CommunityPanel" Classes="panel" Padding="20" DataContext="{Binding Community}" x:DataType="vm:CommunitySectionViewModel">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <StackPanel Grid.Column="0" Spacing="4">
            <TextBlock Classes="section" Text="{x:Static t:Texts.SettingsCommunity}" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static t:Texts.CommunityHelp}" />
          </StackPanel>
          <Button Grid.Column="1" Name="InstallModuleButton" Classes="primary" VerticalAlignment="Top"
                  Content="{x:Static t:Texts.CommunityInstallButton}" Command="{Binding InstallFromFileCommand}" IsEnabled="{Binding IsIdle}" />
        </Grid>

        <!-- La liste des modules validés a été modifiée hors du logiciel. -->
        <Border Name="TamperedBanner" Classes="note" BorderBrush="{DynamicResource Amber}" IsVisible="{Binding StoreTampered}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <controls:CommunityBadge Size="22" VerticalAlignment="Top" />
            <TextBlock Classes="warning" TextWrapping="Wrap" Text="{Binding TamperedText}" />
          </Grid>
        </Border>

        <TextBlock Name="CommunityMessage" Classes="error" TextWrapping="Wrap" MaxLines="6" TextTrimming="CharacterEllipsis"
                   Text="{Binding Message}" IsVisible="{Binding HasMessage}" />

        <TextBlock Name="CommunityNone" Classes="muted" TextWrapping="Wrap" Text="{x:Static t:Texts.CommunityNone}" IsVisible="{Binding HasNoModules}" />

        <ItemsControl Name="CommunityList" ItemsSource="{Binding Modules}" IsVisible="{Binding HasModules}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CommunityModuleRow">
              <Border Classes="note" Margin="0,0,0,8" Padding="14,12">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <controls:CommunityBadge Grid.Column="0" Size="18" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock Classes="name" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="muted" Text="{Binding AuthorLine}" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasAuthorLine}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" MaxWidth="320" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" TextAlignment="Right"
                               VerticalAlignment="Center" Text="{Binding StateText}" Classes.ok="{Binding StateIsOk}" Classes.warning="{Binding StateIsProblem}" />
                  </Grid>
                  <TextBlock Classes="muted" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" Text="{Binding PermissionsText}" />
                  <TextBlock Classes="warning" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis" Text="{Binding Message}" IsVisible="{Binding HasMessage}" />
                  <TextBlock Classes="lead" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                             Text="{Binding UpdateOffer}" IsVisible="{Binding HasUpdateOffer}" />
                  <WrapPanel IsVisible="{Binding IsNotConfirming}">
                    <Button Classes="small primary" Margin="0,0,8,0" Content="{x:Static t:Texts.CommunityApprove}" Command="{Binding ApproveCommand}"
                            IsVisible="{Binding CanApprove}" IsEnabled="{Binding CanApproveNow}" />
                    <Button Classes="small" Margin="0,0,8,0" Content="{x:Static t:Texts.CommunityPermissions}" Command="{Binding PermissionsCommand}"
                            IsVisible="{Binding CanPermissions}" IsEnabled="{Binding CanPermissionsNow}" />
                    <Button Classes="small" Margin="0,0,8,0" Content="{x:Static t:Texts.CommunityUpdate}" Command="{Binding UpdateCommand}"
                            IsVisible="{Binding CanUpdate}" IsEnabled="{Binding CanUpdateNow}" />
                    <Button Classes="small" Margin="0,0,8,0" Content="{x:Static t:Texts.CommunityRelaunch}" Command="{Binding RelaunchCommand}"
                            IsVisible="{Binding CanRelaunch}" IsEnabled="{Binding CanRelaunchNow}" />
                    <Button Classes="small" Margin="0,0,8,0" Content="{x:Static t:Texts.CommunityUninstall}" Command="{Binding AskUninstallCommand}"
                            IsVisible="{Binding CanUninstall}" IsEnabled="{Binding CanUninstallNow}" />
                  </WrapPanel>
                  <StackPanel Spacing="6" IsVisible="{Binding ConfirmingUninstall}">
                    <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding UninstallConfirmText}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Button Classes="small danger" Content="{x:Static t:Texts.CommunityUninstall}" Command="{Binding ConfirmUninstallCommand}" IsEnabled="{Binding IsIdle}" />
                      <Button Classes="small" Content="{x:Static t:Texts.ModulesCancel}" Command="{Binding CancelUninstallCommand}" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:Trofeo.Settings"
        xmlns:vm="clr-namespace:Trofeo.Settings.ViewModels"
        xmlns:controls="clr-namespace:Trofeo.Settings.Controls"
        xmlns:views="clr-namespace:Trofeo.Settings.Views"
        x:Class="Trofeo.Settings.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{x:Static t:Texts.WindowTitle}"
        Icon="/Assets/Brand/ashboard-vision.ico"
        Width="1440" Height="900" MinWidth="1200" MinHeight="760"
        WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="Auto,Auto,Auto,*">

    <!-- En-tête : le symbole et le nom, les cinq onglets (grisés pendant l'assistant), la pastille de l'écran. -->
    <Border Grid.Row="0" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="24,0" Height="64">
        <!-- La fenêtre n'a qu'un thème, le sombre : le symbole sombre (celui de l'icône), décoratif puisque le nom suit. -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,32,0">
          <Image Source="/Assets/Brand/logo-256.png" Width="32" Height="32"
                 RenderOptions.BitmapInterpolationMode="HighQuality"
                 AutomationProperties.AccessibilityView="Raw" />
          <TextBlock Classes="heading" Text="{x:Static t:Texts.AppName}" VerticalAlignment="Center" />
        </StackPanel>

        <ListBox Grid.Column="1" Classes="tabs" VerticalAlignment="Center" IsEnabled="{Binding ShowsTabs}"
                 AutomationProperties.Name="{x:Static t:Texts.TabsName}"
                 ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:TabViewModel">
              <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <views:ScreenPillView Grid.Column="2" DataContext="{Binding Pill}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- L'écran en direct, sur toute la largeur et dans tous les onglets. -->
    <Grid Grid.Row="1" Margin="24,20,24,0">
      <controls:ScreenStrip Name="Strip"
                            AutomationProperties.Name="{x:Static t:Texts.StripName}"
                            Source="{Binding PreviewImage}" Rotation="{Binding PreviewRotation}" />
      <!-- Dans l'onglet Disposition, le damier se pose sur la bande et on y travaille directement. -->
      <controls:GridOverlay Strip="{Binding #Strip}" Model="{Binding LayoutTab}" IsVisible="{Binding IsGridVisible}"
                            AutomationProperties.Name="{x:Static t:Texts.LayoutGridName}" />
    </Grid>

    <!-- Une ligne Amber sous la bande, dans tous les onglets : le message de la dernière modification, les avertissements hors apparence. -->
    <StackPanel Grid.Row="2" Margin="24,12,24,0" Spacing="8" IsVisible="{Binding HasSaveMessage}">
      <TextBlock Name="SaveMessage" Classes="warning" TextWrapping="Wrap" Text="{Binding SaveMessage}" />
      <!-- layout.json ne se lit pas : repartir de la disposition par défaut (le fichier est d'abord copié en .avant-reglages). -->
      <Button Name="ResetLayout" HorizontalAlignment="Left" Content="{x:Static t:Texts.ResetLayout}"
              Command="{Binding ResetLayoutCommand}" IsVisible="{Binding CanResetLayout}" />
    </StackPanel>

    <!-- Le contenu de l'onglet choisi, l'assistant de première ouverture (tant qu'il n'est pas terminé), ou le panneau « service arrêté ». -->
    <Grid Grid.Row="3" Margin="24,16,24,24">
      <ContentControl Name="TabContent" Content="{Binding SelectedTab}" IsVisible="{Binding ShowsTabContent}" />
      <Panel Name="FirstRunHost" IsVisible="{Binding ShowsFirstRun}">
        <views:FirstRunView DataContext="{Binding FirstRun}" />
      </Panel>

      <Border Classes="panel" IsVisible="{Binding IsStopped}" Padding="32"
              HorizontalAlignment="Left" VerticalAlignment="Top" MaxWidth="560">
        <StackPanel Spacing="20">
          <TextBlock Classes="lead" TextWrapping="Wrap" Text="{x:Static t:Texts.ServiceStoppedMessage}" />
          <Button Classes="primary" HorizontalAlignment="Left"
                  Content="{x:Static t:Texts.StartService}" Command="{Binding StartServiceCommand}" />
          <TextBlock Classes="error" TextWrapping="Wrap" Text="{x:Static t:Texts.ServiceNotFound}"
                     IsVisible="{Binding StartFailed}" />
        </StackPanel>
      </Border>

      <!-- Le service tourne mais parle une autre version : pas de bouton, relancer le service n'y changerait rien. -->
      <Border Classes="panel" IsVisible="{Binding IsVersionMismatch}" Padding="32"
              HorizontalAlignment="Left" VerticalAlignment="Top" MaxWidth="560">
        <TextBlock Classes="lead" TextWrapping="Wrap" Text="{x:Static t:Texts.VersionMismatchMessage}" />
      </Border>
    </Grid>
  </Grid>
</Window>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:Trofeo.Settings"
             xmlns:vm="clr-namespace:Trofeo.Settings.ViewModels"
             x:Class="Trofeo.Settings.Views.DowngradeDialogView"
             x:DataType="vm:DowngradeDialogViewModel">

  <!-- La confirmation du retour de la bêta à la stable : le même encadré que celles des modules. -->
  <Border Name="Confirm" Classes="note" HorizontalAlignment="Stretch">
    <StackPanel Spacing="12">
      <TextBlock Name="DowngradeText" TextWrapping="Wrap" Text="{Binding Text}" />
      <CheckBox Name="WaitCheck" Content="{x:Static t:Texts.UpdatesWaitForStable}" IsChecked="{Binding WaitForNextStable}" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Name="ConfirmButton" Classes="primary small" Content="{Binding ConfirmLabel}" Command="{Binding ConfirmCommand}" />
        <Button Name="CancelButton" Classes="small" Content="{x:Static t:Texts.ModulesCancel}" Command="{Binding CancelCommand}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:f="clr-namespace:Trofeo.Settings.ViewModels.Fields"
             x:Class="Trofeo.Settings.Views.Fields.NumberFieldView"
             x:DataType="f:NumberFieldViewModel">

  <!-- Une zone courte pour un nombre ; les bornes et la valeur proposée en dessous, le message en Refuse quand la saisie ne convient pas. -->
  <StackPanel Spacing="8">
    <TextBlock Classes="section" Text="{Binding Label}" TextWrapping="Wrap" />
    <TextBox Name="Box" HorizontalAlignment="Left" Width="160" MaxLength="12" Classes.invalid="{Binding HasError}"
             AutomationProperties.Name="{Binding Label}" Text="{Binding Text}" />
    <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding RangeText}" />
    <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Help}" IsVisible="{Binding HasHelp}" />
    <TextBlock Name="Problem" Classes="error" TextWrapping="Wrap" Text="{Binding Error}" IsVisible="{Binding HasError}" />
  </StackPanel>
</UserControl>

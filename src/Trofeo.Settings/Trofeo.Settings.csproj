<Project Sdk="Microsoft.NET.Sdk">

  <!-- Le logiciel de réglage : un processus à part, qui ne parle au service d'affichage que par Trofeo.Control. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>Trofeo.Settings</AssemblyName>
    <RootNamespace>Trofeo.Settings</RootNamespace>
    <!-- Le nom que voit le Gestionnaire des tâches (le fichier garde son nom). -->
    <AssemblyTitle>Ashboard Vision - Réglages</AssemblyTitle>
    <Description>La fenêtre de réglage d'Ashboard Vision.</Description>
    <!-- Les liaisons de données sont compilées partout (x:DataType) : une faute de nom est une erreur de compilation. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>..\..\assets\brand\ashboard-vision.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Trofeo.Control\Trofeo.Control.csproj" />
    <ProjectReference Include="..\Trofeo.Core\Trofeo.Core.csproj" />
  </ItemGroup>

  <!-- Les polices de l'écran, liées depuis Trofeo.Core (licences OFL comprises). -->
  <ItemGroup>
    <AvaloniaResource Include="..\Trofeo.Core\Assets\Fonts\Manrope-Medium.ttf" Link="Assets\Fonts\Manrope-Medium.ttf" />
    <AvaloniaResource Include="..\Trofeo.Core\Assets\Fonts\BarlowSemiCondensed-Regular.ttf" Link="Assets\Fonts\BarlowSemiCondensed-Regular.ttf" />
    <AvaloniaResource Include="..\Trofeo.Core\Assets\Fonts\BarlowSemiCondensed-SemiBold.ttf" Link="Assets\Fonts\BarlowSemiCondensed-SemiBold.ttf" />
    <!-- Pixelify Sans et VT323 : la liste des polices écrit chaque nom dans sa propre police. -->
    <AvaloniaResource Include="..\Trofeo.Core\Assets\Fonts\PixelifySans-Regular.ttf" Link="Assets\Fonts\PixelifySans-Regular.ttf" />
    <AvaloniaResource Include="..\Trofeo.Core\Assets\Fonts\VT323-Regular.ttf" Link="Assets\Fonts\VT323-Regular.ttf" />
    <Content Include="..\Trofeo.Core\Assets\Fonts\OFL-PixelifySans.txt" Link="Assets\Fonts\OFL-PixelifySans.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Trofeo.Core\Assets\Fonts\OFL-VT323.txt" Link="Assets\Fonts\OFL-VT323.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Trofeo.Core\Assets\Fonts\OFL-Manrope.txt" Link="Assets\Fonts\OFL-Manrope.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Trofeo.Core\Assets\Fonts\OFL-BarlowSemiCondensed.txt" Link="Assets\Fonts\OFL-BarlowSemiCondensed.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- L'icône de la fenêtre et le symbole de l'en-tête : les images de la marque, fabriquées par tools/Trofeo.BrandAssets. -->
  <ItemGroup>
    <AvaloniaResource Include="..\..\assets\brand\ashboard-vision.ico" Link="Assets\Brand\ashboard-vision.ico" />
    <AvaloniaResource Include="..\..\assets\brand\logo-256.png" Link="Assets\Brand\logo-256.png" />
  </ItemGroup>

  <!-- Les vignettes des cartes de thème : faites par l'option « thumbnails » de tools/Trofeo.ThemePreview (voir son aide). -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\Themes\*.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Trofeo.Settings.Tests" />
    <InternalsVisibleTo Include="Trofeo.SettingsPreview" />
  </ItemGroup>

</Project>

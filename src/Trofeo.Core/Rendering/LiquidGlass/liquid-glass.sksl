// Le verre du thème « Liquid Glass avancé » : adaptation en SkSL du programme FS_GLASS de liquidglass.
//
// liquidglass — Copyright (c) ybouane — licence MIT (texte complet : LICENSE-liquidglass.txt, à côté de ce fichier).
// Source : https://github.com/ybouane/liquidglass
// Commit de référence : 59af227103795f06421a96e2c7d3dceb081decd2 (src/shaders.ts, FS_GLASS).
//
// Toutes les étapes, les formules et les constantes sont celles de FS_GLASS. Ce qui a changé :
//   - Coordonnées en pixels, origine en haut à gauche (SkSL), au lieu des UV de WebGL (origine en bas). v_localPx était
//     déjà en pixels du DOM (y vers le bas) : il est repris tel quel. Le facteur pxToUV = (1, −1) / u_res disparaît (les
//     déplacements restent en pixels). La micro-déformation, que l'original ajoutait en UV sans retourner l'axe y, a
//     donc son y inversé ici pour rester la même à l'écran.
//   - Échantillonneurs SkSL : u_bgTex et u_blurTex deviennent les enfants `u_sharp` et `u_blurred` (bords répétés,
//     filtrage linéaire), placés en coordonnées d'écran par leur matrice locale.
//   - Deux programmes au lieu d'un : l'original dessine l'ombre (sdf > 0) et le verre (sdf <= 0) dans le même carré. Ici
//     l'ombre a sa propre image, plus large, qui se pose avant tous les verres. Elle n'est plus coupée à 20 px de la case
//     (SHADOW_PAD) : sa marge suit l'étendue et le décalage.
//   - Le masque 1 − smoothstep(−1,5 ; 0,5 ; sdf) va jusqu'à 0,5 px hors de la forme (l'original le coupait à sdf > 0
//     pour y dessiner l'ombre) : le bord du verre reste lissé, même sans ombre dessous.
//   - La sortie est en alpha prémultiplié (Skia), bornée à [0 ; 1] comme le faisait le tampon d'image de WebGL.
//   - Gardes contre les divisions par zéro et les NaN pour les formes minuscules (elles ne changent rien dès que la
//     forme fait plus de quelques pixels).
//
// Ce fichier contient trois sections, séparées par des lignes « //#section » : `common` (fonctions partagées), `glass`
// et `shadow`. LiquidGlassEffect compile common + glass, et common + shadow.

//#section common

// Distance signée au rectangle arrondi.
float rrSDF(vec2 p, vec2 b, float r) {
	vec2 q = abs(p) - b + vec2(r);
	return min(max(q.x, q.y), 0.0) + length(max(q, vec2(0.0))) - r;
}

// Hauteur du biseau : un demi-cercle (sommet doux au centre, raide au bord), pour les deux formes.
//   forme 0 = pastille biconvexe : la lumière est réfractée par les deux faces.
//   forme 1 = dôme (plan-convexe) : le dessous est plat, une seule réfraction.
// d = distance au bord, vers l'intérieur (−sdf) ; zR = rayon du biseau.
float bevelHeight(float d, float zR) {
	if (d <= 0.0) return 0.0;
	if (d >= zR) return zR;
	return sqrt(d * (2.0 * zR - d));
}

float hash(vec2 p) {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

//#section glass

uniform shader u_sharp;        // la scène nette, en coordonnées d'écran
uniform shader u_blurred;      // la même scène, floutée
uniform vec2 u_origin;         // coin haut gauche de l'image rendue, en coordonnées d'écran
uniform vec2 u_size;           // taille du verre en px
uniform float u_radius;        // rayon des coins en px

uniform float u_refract;
uniform float u_chroma;
uniform float u_edgeHL;
uniform float u_spec;
uniform float u_fresnel;
uniform float u_distort;
uniform float u_alpha;
uniform float u_sat;
uniform float u_tint;
uniform float u_zRadius;
uniform float u_brightness;
uniform float u_bevelMode;

half4 main(vec2 fragCoord) {
	vec2 half_ = u_size * 0.5;
	// Pixels depuis le centre du verre, y vers le bas : le v_localPx de l'original.
	vec2 localPx = fragCoord - half_;
	vec2 screenPx = fragCoord + u_origin;
	float r = min(u_radius, min(half_.x, half_.y));
	float sdf = rrSDF(localPx, half_, r);

	// ── Masque lissé ──
	float mask = 1.0 - smoothstep(-1.5, 0.5, sdf);
	if (mask <= 0.0) return half4(0.0);

	float maxD = min(half_.x, half_.y);
	float inside = -sdf;
	// Garde : une forme sans épaisseur donnerait smoothstep(0, 0, …).
	float edge = smoothstep(max(maxD * 0.35, 0.0001), 0.0, inside);

	// ── Normale de la surface du dessus, par le champ de hauteur du biseau ──
	float zR = max(u_zRadius, 0.0001);
	float e = 2.0;
	float dC = inside;
	float dR = -rrSDF(localPx + vec2(e, 0.0), half_, r);
	float dL = -rrSDF(localPx - vec2(e, 0.0), half_, r);
	float dU = -rrSDF(localPx + vec2(0.0, e), half_, r);
	float dD = -rrSDF(localPx - vec2(0.0, e), half_, r);
	float hC = bevelHeight(dC, zR);
	float hR = bevelHeight(dR, zR);
	float hL = bevelHeight(dL, zR);
	float hU = bevelHeight(dU, zR);
	float hD = bevelHeight(dD, zR);
	vec2 hGrad = vec2(hR - hL, hU - hD) / (2.0 * e);
	vec3 N = normalize(vec3(-hGrad, 1.0));

	float depth = smoothstep(0.0, zR, inside);

	// ── Réfraction (en pixels d'écran) ──
	float ior = 1.5;
	float refrPow = 1.0 - 1.0 / ior;
	float thickness = hC * 2.0;
	float thickNorm = thickness / max(zR * 2.0, 1.0);
	vec2 refrPx;
	if (u_bevelMode < 0.5) {
		// Biconvexe : réfraction par les deux faces.
		vec2 exitRefr = hGrad * refrPow;
		vec2 entryRefr = hGrad * refrPow;
		vec2 throughRefr = entryRefr * thickNorm * 0.5;
		refrPx = (exitRefr + entryRefr + throughRefr) * u_refract * 30.0;
		vec2 centerDir = -localPx / max(half_, vec2(1.0));
		refrPx += centerDir * u_refract * 4.0 * depth;
	} else {
		// Dôme (plan-convexe) : un grossissement uniforme, chaque pixel lit plus près du centre.
		refrPx = -localPx * u_refract * depth * 0.35;
	}

	// ── Micro-déformation ──
	// L'original l'ajoute en UV (y vers le haut) : en pixels d'écran, son y est inversé.
	vec2 ns = localPx * 0.08;
	vec2 micro = (vec2(hash(ns), hash(ns + vec2(37.0))) - 0.5) * u_distort * 4.0 * vec2(1.0, -1.0);

	// ── Franges de couleur ──
	float caS = u_chroma * 18.0 * (edge * 0.7 + 0.3) * 2.0;
	vec2 caD = N.xy * caS;
	vec2 base = screenPx + refrPx + micro;

	vec3 sharp = vec3(
		u_sharp.eval(base + caD).r,
		u_sharp.eval(base).g,
		u_sharp.eval(base - caD).b
	);
	vec3 blur = vec3(
		u_blurred.eval(base + caD).r,
		u_blurred.eval(base).g,
		u_blurred.eval(base - caD).b
	);
	// ── Mélange flou et net selon le bord ──
	// Le centre montre la scène floutée ; le bord revient vers la scène nette, pour que la réfraction y reste franche.
	float edgeMix = (1.0 - edge * 0.15);
	vec3 col = mix(sharp, blur, edgeMix);

	// ── Luminosité ──
	col *= 1.0 + u_brightness;

	// ── Saturation ──
	float lum = dot(col, vec3(0.299, 0.587, 0.114));
	col = mix(vec3(lum), col, 1.0 + u_sat);

	// ── Teinte froide du verre ──
	col = mix(col, col * vec3(0.92, 0.95, 1.05), u_tint);
	col *= 1.0 + 0.06 * depth;

	// ── Fresnel ──
	// Garde : une normale normalisée à 1,0000001 donnerait une base négative, donc un NaN.
	float fres = pow(max(1.0 - abs(N.z), 0.0), 4.0) * u_fresnel;

	// ── Reflets spéculaires (Blinn-Phong, quatre lumières) ──
	vec3 V = vec3(0.0, 0.0, 1.0);
	vec3 L1 = normalize(vec3(0.4, 0.7, 1.0));
	vec3 H1 = normalize(L1 + V);
	float sp1 = pow(max(dot(N, H1), 0.0), 90.0);
	vec3 L2 = normalize(vec3(-0.3, -0.5, 1.0));
	vec3 H2 = normalize(L2 + V);
	float sp2 = pow(max(dot(N, H2), 0.0), 50.0) * 0.3;
	vec3 L3 = normalize(vec3(0.1, 0.3, 1.0));
	float spB = pow(max(dot(N, L3), 0.0), 6.0) * 0.1;
	vec3 L4 = normalize(vec3(0.0, 0.9, 0.4));
	vec3 H4 = normalize(L4 + V);
	float sp4 = pow(max(dot(N, H4), 0.0), 120.0) * 0.6;
	float totalSpec = (sp1 + sp2 + spB + sp4) * u_spec;

	// ── Trait intérieur ──
	float borderWidth = 1.5;
	float innerStroke = smoothstep(-borderWidth - 1.0, -borderWidth, sdf)
	                  * (1.0 - smoothstep(-1.0, 0.0, sdf));
	float topBias = 0.5 + 0.5 * (-localPx.y / max(half_.y, 0.0001));
	innerStroke *= (0.4 + 0.6 * topBias);

	// ── Reflet du bord et lueur intérieure ──
	float rim = edge * u_edgeHL * 0.22;
	float innerGlow = smoothstep(5.0, 0.0, -sdf) * u_edgeHL * 0.15;

	// ── Faux reflet d'environnement ──
	float envRefl = (N.y * 0.5 + 0.5) * fres * 0.08;

	// ── Composition ──
	vec3 fin = col;
	fin += vec3(totalSpec);
	fin += vec3(rim + innerGlow);
	fin += vec3(innerStroke * u_edgeHL * 0.55);
	fin += vec3(envRefl);
	fin = mix(fin, vec3(1.0), fres * 0.2);

	// WebGL bornait la couleur en l'écrivant ; Skia attend en plus un alpha prémultiplié.
	float alpha = clamp(mask * u_alpha, 0.0, 1.0);
	return half4(half3(clamp(fin, 0.0, 1.0) * alpha), half(alpha));
}

//#section shadow

uniform vec2 u_origin;         // position du centre du verre, depuis le coin haut gauche de l'image rendue
uniform vec2 u_size;           // taille du verre en px
uniform float u_radius;        // rayon des coins en px
uniform float u_shadowAlpha;
uniform float u_shadowSpread;
uniform float u_shadowOffY;

half4 main(vec2 fragCoord) {
	vec2 half_ = u_size * 0.5;
	vec2 localPx = fragCoord - u_origin;
	float r = min(u_radius, min(half_.x, half_.y));
	float sdf = rrSDF(localPx, half_, r);

	// ── Ombre (hors du verre, décalée de shadowOffY) ──
	if (sdf > 0.0) {
		float sdfShadow = rrSDF(localPx - vec2(0.0, u_shadowOffY), half_, r);
		float d = max(sdfShadow - 1.0, 0.0);
		float spread = max(u_shadowSpread, 1.0);
		float falloff = 1.0 / (spread * spread);
		float outerShadow = exp(-d * d * falloff) * 0.65;
		float contactShadow = exp(-d * 0.08 / max(spread * 0.04, 0.01)) * 0.35;
		float shadow = clamp((outerShadow + contactShadow) * u_shadowAlpha, 0.0, 1.0);
		return half4(0.0, 0.0, 0.0, half(shadow));
	}
	return half4(0.0);
}
